module

public import Mathlib

/-!
# Light stars and paths in planar graphs of minimum degree five

**Jendrol' and Madaras (1996), Theorem 1.** Every finite simple planar graph of minimum degree
at least five contains a star `K₁,₃ = [X; A₁, A₂, A₃]` whose centre `X` has degree five and whose
leaves have degrees `deg A₁ = 5`, `deg A₂ ≤ 6`, `deg A₃ ≤ 7`, or `deg A₁ = deg A₂ = deg A₃ = 6`
(`LebesgueTheorem.light_star`). The bounds `6` and `7` are best possible (not formalized).
In particular every such graph has a `5`-vertex with three neighbours of degree at most seven,
a form of Lebesgue's results on light stars (1940).

**Theorem 2.** Every such graph contains a star `K₁,₄` whose centre has degree five and whose
leaves have degree at most ten (`LebesgueTheorem.light_star4`).

**Theorem 3.** Every such graph contains a path on four vertices whose degrees sum to at most
`23` (`LebesgueTheorem.light_path4`).

The bounds `10` and `23` are best possible (not formalized).

## Planarity

Planarity is defined combinatorially, through rotation systems of genus zero, exactly as in the
registered entry *Kuratowski's theorem* (PALOMAR-2026-10-15-000018): the definitions below, from
`numClasses` to `IsPlanar`, are copied verbatim from its `Challenge.lean`. A *rotation system*
of `G` is a permutation `rot` of the darts of `G` that maps each dart to a dart with the same tail
and is cyclic on the darts at each vertex; together with the dart reversal `dartSymm` it defines a
hypermap whose faces are the cycles of `rot * dartSymm`. A **plane map** is a rotation system of
Euler defect `0`, and `G` is **planar** if it has one.
-/

@[expose] public section

noncomputable section

open Equiv Equiv.Perm

namespace LebesgueTheorem

/-! ### Combinatorial planarity -/

section Hypermap

variable {α : Type*}

/-- The number of equivalence classes of a setoid. -/
noncomputable def numClasses (s : Setoid α) : ℕ := Nat.card (Quotient s)

/-- The number of cycles of a permutation (fixed points count as cycles of length one). -/
noncomputable def cycleCount (π : Perm α) : ℕ := numClasses (SameCycle.setoid π)

/-- The relation "in the same orbit of the group generated by `σ` and `τ`". -/
def compSetoid (σ τ : Perm α) : Setoid α where
  r := Relation.EqvGen (fun a b => b = σ a ∨ b = τ a)
  iseqv := Relation.EqvGen.is_equivalence _

/-- The number of orbits of the group generated by `σ` and `τ`. -/
noncomputable def numComponents (σ τ : Perm α) : ℕ := numClasses (compSetoid σ τ)

/-- The Euler defect `|α| + 2 K - c(σ) - c(τ) - c(σ τ)` of the hypermap `(σ, τ)`; it equals
twice the genus. -/
noncomputable def eulerDefect (σ τ : Perm α) : ℤ :=
  (Nat.card α : ℤ) + 2 * (numComponents σ τ : ℤ) - cycleCount σ - cycleCount τ -
    cycleCount (σ * τ)

end Hypermap

section Planar

variable {V : Type*} (G : SimpleGraph V)

/-- The dart reversal `d ↦ d.symm` of `G`, as a permutation of the darts. -/
def dartSymm : Perm G.Dart := Function.Involutive.toPerm _ SimpleGraph.Dart.symm_involutive

/-- A rotation system: a permutation of the darts preserving tails and cyclic on the darts at
each vertex. -/
structure IsRotationSystem (σ : Perm G.Dart) : Prop where
  fst_apply : ∀ d, (σ d).fst = d.fst
  sameCycle : ∀ d e : G.Dart, d.fst = e.fst → σ.SameCycle d e

/-- A plane map of `G`: a rotation system of genus zero (Euler defect `0`). -/
structure PlaneMap where
  /-- The rotation: the next dart around the tail. -/
  rot : Perm G.Dart
  isRotationSystem : IsRotationSystem G rot
  eulerDefect_eq_zero : eulerDefect rot (dartSymm G) = 0

/-- `G` is planar: it has a plane map. -/
def IsPlanar : Prop := Nonempty (PlaneMap G)

end Planar

/-! ### Light stars -/

variable {V : Type*} [Fintype V] {G : SimpleGraph V} [DecidableRel G.Adj]

/-- **Jendrol' and Madaras (1996), Theorem 1.** A finite simple planar graph of minimum degree
at least five has a vertex of degree five with three distinct neighbours of degrees
`(5, ≤ 6, ≤ 7)` or `(6, 6, 6)`. -/
theorem light_star [Nonempty V] (hG : IsPlanar G) (hδ : ∀ v, 5 ≤ G.degree v) :
    ∃ x a₁ a₂ a₃ : V, G.Adj x a₁ ∧ G.Adj x a₂ ∧ G.Adj x a₃ ∧ a₁ ≠ a₂ ∧ a₁ ≠ a₃ ∧ a₂ ≠ a₃ ∧
      G.degree x = 5 ∧ ((G.degree a₁ = 5 ∧ G.degree a₂ ≤ 6 ∧ G.degree a₃ ≤ 7) ∨
        (G.degree a₁ = 6 ∧ G.degree a₂ = 6 ∧ G.degree a₃ = 6)) := by
  sorry

/-- **Jendrol' and Madaras (1996), Theorem 2.** A finite simple planar graph of minimum degree
at least five has a vertex of degree five with four distinct neighbours of degree at most ten. -/
theorem light_star4 [Nonempty V] (hG : IsPlanar G) (hδ : ∀ v, 5 ≤ G.degree v) :
    ∃ x a₁ a₂ a₃ a₄ : V, G.Adj x a₁ ∧ G.Adj x a₂ ∧ G.Adj x a₃ ∧ G.Adj x a₄ ∧ a₁ ≠ a₂ ∧ a₁ ≠ a₃ ∧
      a₁ ≠ a₄ ∧ a₂ ≠ a₃ ∧ a₂ ≠ a₄ ∧ a₃ ≠ a₄ ∧ G.degree x = 5 ∧ G.degree a₁ ≤ 10 ∧
      G.degree a₂ ≤ 10 ∧ G.degree a₃ ≤ 10 ∧ G.degree a₄ ≤ 10 := by
  sorry

/-- **Jendrol' and Madaras (1996), Theorem 3.** A finite simple planar graph of minimum degree
at least five has a path on four vertices whose degrees sum to at most `23`. -/
theorem light_path4 [Nonempty V] (hG : IsPlanar G) (hδ : ∀ v, 5 ≤ G.degree v) :
    ∃ a b c d : V, a ≠ b ∧ a ≠ c ∧ a ≠ d ∧ b ≠ c ∧ b ≠ d ∧ c ≠ d ∧ G.Adj a b ∧ G.Adj b c ∧
      G.Adj c d ∧ G.degree a + G.degree b + G.degree c + G.degree d ≤ 23 := by
  sorry

end LebesgueTheorem
